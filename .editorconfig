# =============================================================================
# EditorConfig - エディタ間で統一されたコーディングスタイル
# =============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go は indent_style = tab のため、indent_size ではなく tab_width を指定する
[*.go]
indent_style = tab
tab_width = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
