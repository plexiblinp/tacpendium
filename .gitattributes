# =============================================================================
# 改行コード正規化
# Windows (CRLF) / Linux (LF) の差異によるトラブルを防止
# =============================================================================

# デフォルト：すべてのテキストファイルを LF に統一
* text=auto eol=lf

# --- 明示指定（text=auto の判定が曖昧なファイル種別） ---
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.go       text eol=lf
*.sh       text eol=lf
Dockerfile text eol=lf

# --- Windows 用バッチファイルのみ CRLF を維持 ---
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# --- バイナリファイル（変換しない） ---
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.db binary
*.sqlite binary
